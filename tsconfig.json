{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@renderer/*": ["src/renderer/*"],
      "@main/*": ["src/main/*"],
      "@khepree/sdk": ["vendor/@khepree/sdk/src/index.ts"]
    }
  },
  "include": [
    "src/**/*",
    "tests/**/*",
    "forge.config.ts",
    "vite.*.config.ts",
    "vitest.config.ts",
    "vitest.perf.config.ts",
    "vitest.google-smoke.config.ts",
    "vitest.notebook-grounding-smoke.config.ts"
  ],
  "exclude": ["node_modules", ".vite", "out"]
}
